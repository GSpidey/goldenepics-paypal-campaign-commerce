test('unpaid order never enters production',async t=>{const f=setup(t);const o=f.app.create('owner',{brief,packageId:'starter'});await assert.rejects(f.app.fulfill(o.id,'owner'),e=>e.kind==='payment');assert.equal(f.counts().generated,0);});
test('tampered completed payment is rejected for wrong amount, currency, ID and pending status',t=>{const f=setup(t);const o={id:'internal',paypalId:'PAYPAL123',currency:'USD',amount:'9.00'};for(const mutate of [r=>r.id='OTHER',r=>r.status='APPROVED',r=>r.purchase_units[0].custom_id='other',r=>r.purchase_units[0].payments.captures[0].amount.value='0.01',r=>r.purchase_units[0].payments.captures[0].amount.currency_code='CAD',r=>r.purchase_units[0].payments.captures[0].status='PENDING']){const r=f.completed(o);mutate(r);assert.throws(()=>verifyCapture(o,r),e=>e.kind==='verification');}});
test('approved amount mismatch is rejected before capture request',async t=>{const f=setup(t);const o=f.app.create('owner',{brief,packageId:'starter'});await f.app.proposal(o.id,'owner');await f.app.checkout(o.id,'owner');f.paypal.get=async()=>({id:'PAYPAL123',status:'APPROVED',purchase_units:[{custom_id:o.id,amount:{value:'1.00',currency_code:'USD'}}]});await assert.rejects(f.app.capture(o.id,'owner'));assert.equal(f.counts().captured,0);});
test('lost capture response is reconciled by read before any repeated capture',async t=>{const f=setup(t);const o=f.app.create('owner',{brief,packageId:'starter'});await f.app.proposal(o.id,'owner');await f.app.checkout(o.id,'owner');const capture=f.paypal.capture;f.paypal.capture=async o=>{await capture(o);throw new ProviderError('lost response','uncertain');};await assert.rejects(f.app.capture(o.id,'owner'));const recovered=await f.app.capture(o.id,'owner');assert.ok(recovered.receipt);assert.equal(f.counts().captured,1);});
test('production failure preserves paid status and can retry only the failed delivery',async t=>{const f=setup(t);const o=await paid(f);const generate=f.ai.generate;f.ai.generate=async()=>{throw new ProviderError('temporary production failure');};await assert.rejects(f.app.fulfill(o.id,'owner'));assert.ok(f.app.owned(o.id,'owner').receipt);assert.ok(f.app.owned(o.id,'owner').proposal);f.ai.generate=generate;assert.equal((await f.app.fulfill(o.id,'owner')).state,'delivered');assert.equal(f.counts().captured,1);});
test('uncertain checkout is retained and reconciliation reuses saved request identity',async t=>{const f=setup(t);const o=f.app.create('owner',{brief,packageId:'starter'});await f.app.proposal(o.id,'owner');const create=f.paypal.create;let seen=[];f.paypal.create=async order=>{seen.push(order.id);if(seen.length===1)throw new ProviderError('timeout','uncertain');return create(order);};await assert.rejects(f.app.checkout(o.id,'owner'));await assert.rejects(f.app.checkout(o.id,'owner'),e=>e.kind==='uncertain');await f.app.reconcileCreate(o.id,'owner');assert.deepEqual(seen,[o.id,o.id]);});
test('missing account configuration does not create an uncertain payment',async t=>{const f=setup(t);const o=f.app.create('owner',{brief,packageId:'starter'});await f.app.proposal(o.id,'owner');f.paypal.create=async()=>{throw new ProviderError('setup','setup');};await assert.rejects(f.app.checkout(o.id,'owner'));assert.equal(f.app.owned(o.id,'owner').createUncertain,false);});
test('SQLite orders and generation allowance survive service restart',()=>{const dir=mkdtempSync(join(tmpdir(),'commerce-'));try{let s=new Store(join(dir,'store.sqlite'));s.put({id:'one',owner:'a',state:'paid'});assert.equal(s.reserve(1),true);s.close();s=new Store(join(dir,'store.sqlite'));assert.equal(s.get('one','a').state,'paid');assert.equal(s.reserve(1),false);s.close();}finally{rmSync(dir,{recursive:true,force:true});}});
test('redirect allowlist accepts only PayPal Sandbox approval URLs',()=>{assert.equal(approvalLink({links:[{rel:'approve',href:'https://evil.test/'}]}),null);assert.equal(approvalLink({links:[{rel:'approve',href:'https://www.paypal.com/'}]}),null);assert.ok(approvalLink({links:[{rel:'approve',href:'https://www.sandbox.paypal.com/checkoutnow'}]}));});
test('PayPal client pins sandbox origin and stable idempotency headers',async()=>{const calls=[];const pp=new PayPal({PAYPAL_CLIENT_ID:'fixture',PAYPAL_CLIENT_SECRET:'fixture'},async(url,opts)=>{calls.push({url,opts});return Response.json(url.endsWith('/token')?{access_token:'fixture',expires_in:300}:{id:'PAYPAL123'});});const o={id:'internal',amount:'9.00',currency:'USD',packageId:'starter',paypalId:'PAYPAL123'};await pp.create(o,'https://example.test');await pp.capture(o);assert.ok(calls.every(c=>c.url.startsWith('https://api-m.sandbox.paypal.com/')));assert.equal(calls[1].opts.headers['PayPal-Request-Id'],'internal-create');assert.equal(calls[2].opts.headers['PayPal-Request-Id'],'internal-capture');});
test('HTTP workspace requires same-origin JSON for writes and isolates browser sessions',async t=>{const f=setup(t);const server=makeServer({APP_ORIGIN:'http://localhost',AI_DAILY_MAX_CALLS:'5'},{store:f.store,paypal:f.paypal,ai:f.ai});await new Promise(r=>server.listen(0,'127.0.0.1',r));t.after(()=>new Promise(r=>{server.closeAllConnections();server.close(r);}));const root='http://127.0.0.1:'+server.address().port;const page=await fetch(root+'/api/workspace');const cookie=page.headers.get('set-cookie').split(';')[0];const body=JSON.stringify({brief,packageId:'starter'});assert.equal((await fetch(root+'/api/orders',{method:'POST',headers:{origin:'https://other.test','content-type':'application/json',cookie},body})).status,403);assert.equal((await fetch(root+'/api/orders',{method:'POST',headers:{origin:'http://localhost','content-type':'application/json',cookie},body})).status,201);assert.equal((await(await fetch(root+'/api/workspace',{headers:{cookie}})).json()).orders.length,1);assert.equal((await(await fetch(root+'/api/workspace')).json()).orders.length,0);});
